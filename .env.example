# Copy to .env and adjust. deploy/setup.sh generates this automatically in production.
FLASK_APP=wsgi.py

# development | production  (production refuses to start without SECRET_KEY)
GATEKEEPER_ENV=development

# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Password for the auto-seeded 'admin' account on first start.
ADMIN_DEFAULT_PASSWORD=admin

# SQLite location. Omit to use instance/gatekeeper.db.
# DATABASE_URL=sqlite:////opt/gatekeeper/instance/gatekeeper.db

# Set to 1 when served over HTTPS (also required for the iPad screen Wake Lock).
SESSION_COOKIE_SECURE=0
